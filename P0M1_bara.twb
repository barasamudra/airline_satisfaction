  <windows saved-dpi-scale-factor='1.25' source-height='37'>
    <window class='worksheet' name='Jumlah penumpang puas berdasarkan kelas penerbangan dan tujuan penerbangan'>
      <cards>
        <edge name='left'>
          <strip size='160'>
            <card type='pages' />
            <card type='filters' />
            <card type='marks' />
          </strip>
        </edge>
        <edge name='top'>
          <strip size='2147483647'>
            <card type='columns' />
          </strip>
          <strip size='2147483647'>
            <card type='rows' />
          </strip>
          <strip size='2147483647'>
            <card type='title' />
